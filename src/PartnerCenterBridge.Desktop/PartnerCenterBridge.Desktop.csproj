<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PartnerCenterBridge</AssemblyName>
    <Version>0.9.2</Version>
    <ApplicationIcon>../PartnerCenterBridge.Api/Assets/app.ico</ApplicationIcon>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <ProjectReference Include="../PartnerCenterBridge.Api/PartnerCenterBridge.Api.csproj" />
    <Resource Include="../../web/public/brand/logo-128.png" Link="brand/logo-128.png" />
  </ItemGroup>
</Project>
